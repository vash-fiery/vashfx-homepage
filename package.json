{
  "name": "vashfx-homepage",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --test --experimental-strip-types tests/api.test.ts worker/index.test.ts",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@openai/codex": "^0.163.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eruda": "^3.4.3",
    "oxlint": "^1.89.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.4",
    "workerd": "^1.20261016.1",
    "wrangler": "^4.151.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
